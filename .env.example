# --- Database -----------------------------------------------------------
# Leave DATABASE_URL unset to run on the bundled embedded Postgres (PGlite),
# persisted under ./data/sitesignal. Zero setup, identical SQL dialect.
#
# Point it at a real Postgres to switch drivers with no code change:
# DATABASE_URL=postgres://user:password@localhost:5432/sitesignal

# --- Server -------------------------------------------------------------
PORT=5174

# Where PGlite persists when DATABASE_URL is unset.
PGLITE_DIR=./data/sitesignal

# --- Open-Meteo ---------------------------------------------------------
# No API key required. Cache window for ambient conditions, in minutes.
WEATHER_CACHE_MINUTES=15
WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast
