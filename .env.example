# Every value below has a working default. The app runs with no .env at all.

# --- Ports ---------------------------------------------------------------
# The single public port. Replit injects this and maps it to the external URL.
# Production serves the API and the built client from it; in development Vite
# takes it and proxies /api to API_PORT.
PORT=5000

# Development only: where the Express process moves aside to.
API_PORT=5174

# 0.0.0.0 so the container port is reachable from outside.
HOST=0.0.0.0

# --- Database ------------------------------------------------------------
# Leave DATABASE_URL unset to run on the bundled embedded Postgres (PGlite),
# persisted under ./data/sitesignal. Zero setup, identical SQL dialect.
#
# Point it at a real Postgres to switch drivers with no code change:
# DATABASE_URL=postgres://user:password@localhost:5432/sitesignal

# Where PGlite persists when DATABASE_URL is unset.
PGLITE_DIR=./data/sitesignal

# Approximate number of reading rows the seeder generates. The 60-day history
# window is fixed; this changes the sampling resolution inside it.
SEED_READINGS=18000

# --- Open-Meteo ----------------------------------------------------------
# No API key required. Cache window for ambient conditions, in minutes.
WEATHER_CACHE_MINUTES=15
WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast
