# SiteSignal — Replit configuration
#
# NODE VERSION: the `nodejs-22` module below pins the toolchain. Confirm it in
# the workspace after importing (Tools → Dependencies, or `node -v` in the
# shell): if the account/template resolves a different major, change this line
# and the `engines.node` range in package.json together. The project is
# developed and verified on Node 22.17.
modules = ["nodejs-20"]

entrypoint = "README.md"
run = "npm run dev"

hidden = [".config", "dist", "node_modules", "data"]

[nix]
channel = "stable-24_11"

# Replit exposes exactly one port publicly. 5000 is what both `npm run dev`
# (Vite, proxying /api internally) and `npm start` (Express, serving API +
# client) bind, so the same URL works in the workspace and in a deployment.
[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "npm run build"]
run = ["sh", "-c", "npm start"]

[env]
# Belt and braces: PORT is normally injected by Replit, but the workspace shell
# does not always set it.
PORT = "5000"
HOST = "0.0.0.0"
